{
    "name": "pest_disease_data",
    "table": "pest_disease_data",
    "crud": {
        "isuper": [
            "c",
            "r",
            "u",
            "a",
            "d"
        ],
        "islogin": [
            "r",
            "a"
        ]
    },
    "enable": 1,
    "relations": {},
    "data": [
        {
            "name": "name",
            "datatype": "string",
            "sql_attribute": "NOT NULL UNIQUE COMMENT 'Pest or disease name'",
            "mysql_data": "varchar(255)"
        },
        {
            "name": "type",
            "datatype": "string",
            "sql_attribute": "NOT NULL COMMENT 'pest or disease'",
            "mysql_data": "varchar(50)"
        },
        {
            "name": "scientific_name",
            "datatype": "string",
            "mysql_data": "varchar(255)",
            "default": "NULL"
        },
        {
            "name": "description",
            "datatype": "string",
            "sql_attribute": "NOT NULL",
            "mysql_data": "text"
        },
        {
            "name": "affected_crops",
            "datatype": "string",
            "sql_attribute": "COMMENT 'JSON array of crop names'",
            "mysql_data": "text",
            "default": "NULL"
        },
        {
            "name": "risk_stages",
            "datatype": "string",
            "sql_attribute": "COMMENT 'JSON array of vulnerable growth stages'",
            "mysql_data": "text",
            "default": "NULL"
        },
        {
            "name": "temperature_min",
            "datatype": "number",
            "sql_attribute": "COMMENT 'Minimum temperature for risk (Celsius)'",
            "mysql_data": "DECIMAL(5,2)",
            "default": "NULL"
        },
        {
            "name": "temperature_max",
            "datatype": "number",
            "sql_attribute": "COMMENT 'Maximum temperature for risk (Celsius)'",
            "mysql_data": "DECIMAL(5,2)",
            "default": "NULL"
        },
        {
            "name": "humidity_min",
            "datatype": "number",
            "sql_attribute": "COMMENT 'Minimum humidity for risk (%)'",
            "mysql_data": "INT",
            "default": "NULL"
        },
        {
            "name": "humidity_max",
            "datatype": "number",
            "sql_attribute": "COMMENT 'Maximum humidity for risk (%)'",
            "mysql_data": "INT",
            "default": "NULL"
        },
        {
            "name": "rainfall_min",
            "datatype": "number",
            "sql_attribute": "COMMENT 'Minimum rainfall for risk (mm)'",
            "mysql_data": "DECIMAL(6,2)",
            "default": "NULL"
        },
        {
            "name": "severity",
            "datatype": "string",
            "sql_attribute": "NOT NULL COMMENT 'low, medium, high'",
            "mysql_data": "varchar(50)"
        },
        {
            "name": "organic_treatments",
            "datatype": "string",
            "sql_attribute": "COMMENT 'JSON array of organic treatment options'",
            "mysql_data": "text",
            "default": "NULL"
        },
        {
            "name": "chemical_treatments",
            "datatype": "string",
            "sql_attribute": "COMMENT 'JSON array of chemical treatment options'",
            "mysql_data": "text",
            "default": "NULL"
        },
        {
            "name": "prevention_measures",
            "datatype": "string",
            "sql_attribute": "COMMENT 'JSON array of prevention measures'",
            "mysql_data": "text",
            "default": "NULL"
        },
        {
            "name": "timing_instructions",
            "datatype": "string",
            "sql_attribute": "COMMENT 'Application timing guidance'",
            "mysql_data": "text",
            "default": "NULL"
        },
        {
            "name": "data_source",
            "datatype": "string",
            "sql_attribute": "COMMENT 'ICAR, state dept, etc'",
            "mysql_data": "varchar(255)",
            "default": "NULL"
        },
        {
            "name": "last_updated",
            "datatype": "Date",
            "mysql_data": "timestamp",
            "default": "NULL"
        }
    ]
}