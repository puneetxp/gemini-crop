<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/surface"
    android:padding="16dp"
    android:layout_marginBottom="12dp">

    <!-- Top Row: Icon and Badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <!-- Icon Container -->
        <LinearLayout
            android:id="@+id/containerIcon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="#d1fae5"
            android:gravity="center">

            <TextView
                android:id="@+id/tvIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🧠"
                android:textSize="24sp" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Badge -->
        <TextView
            android:id="@+id/tvBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Multimodal AI"
            android:textColor="#ffffff"
            android:background="#10b981"
            android:textSize="10sp"
            android:textStyle="bold"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />
    </LinearLayout>

    <!-- Title and Description -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="AI Crop Diagnosis"
        android:textColor="@color/primary"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Instant foliar disease scanning with Vision AI, lesion segmentation, and ICAR treatment plans."
        android:textColor="#3f4944"
        android:textSize="12sp"
        android:layout_marginTop="8dp"
        android:lineSpacingExtra="4dp" />

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#e2e8f0"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="12dp" />

    <!-- Bottom Action Button -->
    <Button
        android:id="@+id/btnAction"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_gravity="end"
        android:text="Launch Scanner"
        android:textColor="#ffffff"
        android:backgroundTint="@color/primary"
        android:textSize="12sp"
        android:textStyle="bold"
        android:paddingLeft="16dp"
        android:paddingRight="16dp" />

</LinearLayout>
