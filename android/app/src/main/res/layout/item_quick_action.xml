<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@color/surface"
    android:padding="14dp"
    android:layout_marginBottom="10dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="#dcfce7"
        android:gravity="center">

        <TextView
            android:id="@+id/tvActionIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚡"
            android:textColor="#166534"
            android:textSize="18sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp">

        <TextView
            android:id="@+id/tvActionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Action Title"
            android:textColor="#0f172a"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvActionSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Subtitle description"
            android:textColor="#64748b"
            android:textSize="11sp"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvActionBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="NEW"
        android:textColor="#ffffff"
        android:background="#16a34a"
        android:textSize="9sp"
        android:textStyle="bold"
        android:paddingHorizontal="6dp"
        android:paddingVertical="2dp"
        android:visibility="gone" />

</LinearLayout>
