# Copy to python/.env for local development. Never commit the real .env.
ENVIRONMENT=development          # development | test | production (production rejects mock tokens)
DEBUG=false
SECRET_KEY=change-me

POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=cropsense_dev

# Google Cloud: Gemini runs on Vertex AI with Application Default Credentials
# (gcloud auth application-default login)
GOOGLE_CLOUD_PROJECT=your-gcp-project
GEMINI_LOCATION=global           # Gemini 3.x is served from the global endpoint
FIREBASE_PROJECT_ID=your-gcp-project
FIREBASE_API_KEY=                # Firebase web API key; needed for email/password sign-in outside development

# Data sources (optional locally)
OPENWEATHER_API_KEY=             # weather forecast + district geocoding for crop plans
DATAGOV_API_KEY=                 # data.gov.in Agmarknet mandi prices (python/scripts/fetch_live_api_prices.py)
DATAGOV_MOISTURE_API_KEY=        # data.gov.in soil moisture
